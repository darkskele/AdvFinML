{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🟢 Run Main (src/main.cpp)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/main_exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
