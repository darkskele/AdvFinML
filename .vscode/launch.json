{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🟢 Run Main (src/main.cpp)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/app/finml_app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Clean Build Main",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "🧪 Run Tests (GoogleTest)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tests/finml_tests",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Clean Build Tests",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
